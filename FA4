stud = int(input("Enter amount of students: "))
subj = int(input("Enter amount of subjects: "))
 
section = 0

for i in range(stud):
    student = 0
    
    for j in range(subj):
        score = float(input(f"Enter score of student {i+1}, subject {j+1}: "))
        student += score
        section += score
        
    student_average = student / subj
    print(f"Average of student {i+1}: {student_average:.2f}")

class_average = section / (stud * subj)
print(f"Class average: {class_average:.2f}")
